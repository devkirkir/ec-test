# development | production | test
NODE_ENV=development

# сгенерировать: npm run build && npm run gen:key
API_KEY=

COIN_MARKET_CAP_API_KEY=
COIN_MARKET_CAP_BASE_URL=https://pro-api.coinmarketcap.com
# валюта конвертации, поддерживается только USD
COIN_MARKET_CAP_CONVERT_CURRENCY=USD
# таймаут запроса к CoinMarketCap в мс
COIN_MARKET_CAP_TIMEOUT_MS=5000

APP_PORT=5000
# ERROR | WARN | INFO | DEBUG | TRACE
APP_LOG_LEVEL=info
# интервал фоновой синхронизации цен в секундах
APP_SCHEDULE_INTERVAL_SEC=60

# путь к файлу бд SQLite
DB_PATH=./data/app.sqlite

GRACEFUL_TIMEOUT_SHUTDOWN_MS=3000
