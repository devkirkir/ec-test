{
  "name": "evercode",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.20.8"
  },
  "scripts": {
    "dev": "npm run build && npm run start:local",
    "dev:watch": "tsc --watch && node --watch dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start:local": "node dist/index.js",
    "start:docker": "node dist/index.js",
    "gen:key": "node dist/lib/apiKeyGenerator.js",
    "test": "TZ=UTC NODE_OPTIONS='--experimental-vm-modules --expose-gc' jest"
  },
  "imports": {
    "#config": {
      "development": "./src/config/index.js",
      "default": "./dist/config/index.js"
    },
    "#db": {
      "development": "./src/db/index.js",
      "default": "./dist/db/index.js"
    },
    "#lib/*": {
      "development": "./src/lib/*",
      "default": "./dist/lib/*"
    },
    "#integrations/*": {
      "development": "./src/integrations/*",
      "default": "./dist/integrations/*"
    },
    "#repositories/*": {
      "development": "./src/repositories/*",
      "default": "./dist/repositories/*"
    }
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^18.19.130",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
