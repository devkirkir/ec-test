{
  "name": "evercode",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=.env ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start:local": "node --env-file=.env dist/index.js"
  },
  "imports": {
    "#config": {
      "development": "./src/config/index.js",
      "default": "./dist/config/index.js"
    },
    "#db": {
      "development": "./src/db/index.js",
      "default": "./dist/db/index.js"
    },
    "#lib/*": {
      "development": "./src/lib/*",
      "default": "./dist/lib/*"
    }
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
